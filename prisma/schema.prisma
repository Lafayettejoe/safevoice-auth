generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions            Session[]
  verificationCodes   VerificationCode[]
  passwordResetTokens PasswordResetToken[]
  subscription        Subscription?
  aiJobs              AIJob[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Plan: the three available plans in SafeVoice
model Plan {
  id        String      @id @default(cuid())
  name      String
  interval  PlanInterval
  amount    Int         // stored in kobo: 0, 500000, 4800000
  currency  String      @default("NGN")
  createdAt DateTime    @default(now())

  subscriptions Subscription[]
}

// Subscription: one row per user showing their current plan
model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id])
  status              SubscriptionStatus @default(ACTIVE)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean            @default(false)
  cancellationReason  String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  payments PaymentLog[]
  @@index([userId])
}

// PaymentLog: append-only record of every payment event
// Every stage (initiated, verified, fulfilled, failed) is a separate row
model PaymentLog {
  id                String       @id @default(cuid())
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  userId            String
  stage             PaymentStage
  amount            Int          // in kobo
  currency          String       @default("NGN")
  providerReference String?      // Flutterwave transaction ID
  metadata          Json?
  createdAt         DateTime     @default(now())

  @@index([providerReference])
  @@index([userId])
  @@index([stage])
}

enum PlanInterval {
  FREE
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentStage {
  INITIATED
  VERIFIED
  FULFILLED
  FAILED
}

// AIJob: tracks every upload and processing job
model AIJob {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileKey         String     // storage key only — never the file itself
  fileName        String
  fileSize        Int
  status          JobStatus  @default(PENDING)
  attempts        Int        @default(0)
  errorMessage    String?
  transcriptText  String?
  riskLevel       String?
  riskRationale   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}